<UserControl x:Class="IntegradorView.Pages.ConfigucaoModelo.ConfiguracaoModelo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:IntegradorView.Pages.ConfigucaoModelo"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Background="{DynamicResource MaterialDesignPaper}">
    <Grid>
        <DockPanel>
            <Grid DockPanel.Dock="Bottom">
                <Grid Margin="15">
                    <Button Content="EXCLUIR MODELO" 
                                Foreground="Red" 
                                Style="{StaticResource MaterialDesignFlatButton}" 
                                HorizontalAlignment="Left"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="CANCELAR" 
                                Margin="0,0,10,0" 
                                Style="{StaticResource MaterialDesignOutlinedButton}"/>
                        <Button Content="APLICAR ALTERAÇÕES" 
                                Width="Auto" 
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Background="#0D47A1"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <ScrollViewer VerticalScrollBarVisibility="Auto">

                <Grid Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- MODEL CARD -->
                    <Border Grid.Row="0"
                            Padding="24"
                            CornerRadius="20"
                            Background="White"
                            BorderBrush="#E6E6E6"
                            BorderThickness="1">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                                    Kind="CubeOutline"
                                                    Width="28"
                                                    Height="28"
                                                    Foreground="#5B5CEB"
                                                    VerticalAlignment="Center"/>

                                    <TextBlock Margin="12,0,0,0"
                                               FontSize="24"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Text="Churn_Prediction_Model"/>

                                    <Border Margin="16,0,0,0"
                                            Padding="10,4"
                                            Background="#DCFCE7"
                                            CornerRadius="12"
                                            VerticalAlignment="Center">

                                        <TextBlock Text="Ativo"
                                                   FontWeight="SemiBold"
                                                   Foreground="#15803D"/>
                                    </Border>
                                </StackPanel>

                                <UniformGrid Margin="0,24,0,0" Columns="5">

                                    <StackPanel>
                                        <TextBlock Foreground="#7A7A7A"
                                                   FontSize="13"
                                                   Text="Versão"/>

                                        <TextBlock Margin="0,6,0,0"
                                                   FontWeight="SemiBold"
                                                   FontSize="16"
                                                   Text="1.0.0"/>
                                    </StackPanel>

                                    <StackPanel>
                                        <TextBlock Foreground="#7A7A7A"
                                                   FontSize="13"
                                                   Text="Formato"/>

                                        <TextBlock Margin="0,6,0,0"
                                                   FontWeight="SemiBold"
                                                   FontSize="16"
                                                   Text="ONNX"/>
                                    </StackPanel>

                                    <StackPanel>
                                        <TextBlock Foreground="#7A7A7A"
                                                   FontSize="13"
                                                   Text="Criado em"/>

                                        <TextBlock Margin="0,6,0,0"
                                                   FontWeight="SemiBold"
                                                   FontSize="16"
                                                   Text="12/05/2026 14:30"/>
                                    </StackPanel>

                                    <StackPanel>
                                        <TextBlock Foreground="#7A7A7A"
                                                   FontSize="13"
                                                   Text="Atualizado em"/>

                                        <TextBlock Margin="0,6,0,0"
                                                   FontWeight="SemiBold"
                                                   FontSize="16"
                                                   Text="18/05/2026 09:15"/>
                                    </StackPanel>

                                    <StackPanel>
                                        <TextBlock Foreground="#7A7A7A"
                                                   FontSize="13"
                                                   Text="Arquivo"/>

                                        <TextBlock Margin="0,6,0,0"
                                                   FontWeight="SemiBold"
                                                   FontSize="16"
                                                   Text="churn_model_v1.onnx"/>
                                    </StackPanel>

                                </UniformGrid>
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Height="42"
                                    Padding="24,0"
                                    VerticalAlignment="Top"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Content="Atualizar Modelo"/>
                        </Grid>
                    </Border>

                    <!-- CARDS -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- SCHEMA -->
                        <Border Grid.Column="0"
                                Padding="20"
                                Background="White"
                                CornerRadius="20"
                                BorderBrush="#E6E6E6"
                                BorderThickness="1">

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="16"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="16"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                                        Kind="TableColumn"
                                                        Width="22"
                                                        Height="22"
                                                        Foreground="#5B5CEB"/>

                                        <TextBlock Margin="12,0,0,0"
                                                   FontSize="20"
                                                   FontWeight="SemiBold"
                                                   Text="Schema"/>
                                    </StackPanel>

                                    <Border DockPanel.Dock="Right"
                                            Padding="10,4"
                                            Background="#EEF2FF"
                                            CornerRadius="10"
                                            HorizontalAlignment="Right">

                                        <TextBlock Text="v3"
                                                   Foreground="#4338CA"
                                                   FontWeight="SemiBold"/>
                                    </Border>
                                </Grid>

                                <DataGrid Grid.Row="2"
                                          ItemsSource="{Binding SchemaPreview}"
                                          AutoGenerateColumns="False"
                                          HeadersVisibility="Column"
                                          CanUserAddRows="False"
                                          BorderThickness="0"
                                          MaxHeight="350"
                                          RowBackground="Transparent"
                                          AlternatingRowBackground="#FAFAFA">

                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Coluna" Binding="{Binding Coluna}" Width="3*" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Finalidade" Binding="{Binding Finalidade}" Width="2*" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="2*" IsReadOnly="True"/>

                                        <DataGridTemplateColumn Header="Categórica" Width="3*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                                                        <CheckBox IsChecked="{Binding Categorico, Mode=OneWay}" 
                                                                  IsHitTestVisible="False" 
                                                                  Focusable="False"
                                                                  VerticalAlignment="Center"/>

                                                        <Button Content="Verificar"
                                                                Margin="10,0,0,0"
                                                                Padding="8,2"
                                                                FontSize="11"
                                                                VerticalAlignment="Center">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>

                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Categorico}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>

                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <Button Grid.Row="4"
                                        Height="42"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Content="Atualizar Schema"/>
                            </Grid>
                        </Border>

                        <!-- PIPELINE -->
                        <Border Grid.Column="2"
                                Padding="20"
                                Background="White"
                                CornerRadius="20"
                                BorderBrush="#E6E6E6"
                                BorderThickness="1">

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="16"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="16"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                                        Kind="SourceBranch"
                                                        Width="22"
                                                        Height="22"
                                                        Foreground="#5B5CEB"/>

                                        <TextBlock Margin="12,0,0,0"
                                                   FontSize="20"
                                                   FontWeight="SemiBold"
                                                   Text="Pipeline"/>
                                    </StackPanel>

                                    <Border DockPanel.Dock="Right"
                                            Padding="10,4"
                                            Background="#EEF2FF"
                                            CornerRadius="10"
                                            HorizontalAlignment="Right">

                                        <TextBlock Text="v5"
                                                   Foreground="#4338CA"
                                                   FontWeight="SemiBold"/>
                                    </Border>
                                </Grid>

                                <ItemsControl ItemsSource="{Binding Pipeline}"
                                              Grid.Row="2"
                                              MaxHeight="350">
                                    <ItemsControl.Template>
                                        <ControlTemplate TargetType="ItemsControl">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto" 
                                                              HorizontalScrollBarVisibility="Disabled">
                                                <ItemsPresenter />
                                            </ScrollViewer>
                                        </ControlTemplate>
                                    </ItemsControl.Template>

                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <VirtualizingStackPanel Margin="0,0,10,0"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>

                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Expander Style="{StaticResource MaterialDesignExpander}"
                                                          Margin="0,0,0,12"
                                                          Padding="14"
                                                          Background="#FAFAFA">

                                                <Expander.Header>
                                                    <TextBlock FontWeight="SemiBold"
                                                                   FontSize="20"
                                                                   Text="{Binding Key}"/>

                                                </Expander.Header>

                                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20">
                                                    <TextBox  Text="{Binding Value, Mode=OneWay}"
                                                                  Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                                  FontFamily="Consolas" 
                                                                  FontSize="14"
                                                                  IsReadOnly="True"
                                                                  VerticalScrollBarVisibility="Auto"
                                                                  HorizontalScrollBarVisibility="Auto"
                                                                  TextWrapping="Wrap"
                                                                  Margin="10"
                                                                  VerticalAlignment="Stretch"
                                                                  MinHeight="200">

                                                    </TextBox>
                                                </ScrollViewer>

                                            </Expander>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Button Grid.Row="4"
                                        Height="42"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Content="Atualizar Pipeline"/>
                                        </Grid>
                        </Border>

                        <!-- Transformadores -->
                        <Border Grid.Column="4"
                                Padding="20"
                                Background="White"
                                CornerRadius="20"
                                BorderBrush="#E6E6E6"
                                BorderThickness="1">

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="16"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="16"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Orientation="Horizontal" Grid.Row="0">
                                    <materialDesign:PackIcon Kind="DatabaseOutline"
                                                             Width="22"
                                                             Height="22"
                                                             Foreground="#5B5CEB"/>

                                    <TextBlock Margin="12,0,0,0"
                                               FontSize="20"
                                               FontWeight="SemiBold"
                                               Text="Transformadores"/>
                                </StackPanel>

                                <ItemsControl ItemsSource="{Binding Transformadores}"
                                              Grid.Row="2"
                                              MinHeight="350"
                                              MaxHeight="350">
                                    <ItemsControl.Template>
                                        <ControlTemplate TargetType="ItemsControl">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto" 
                                                          HorizontalScrollBarVisibility="Disabled">
                                                <ItemsPresenter />
                                            </ScrollViewer>
                                        </ControlTemplate>
                                    </ItemsControl.Template>

                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <VirtualizingStackPanel Margin="0,0,10,0"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>

                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,16"
                                                    Padding="16"
                                                    Background="#FAFAFA"
                                                    CornerRadius="16">
                                                <Grid>
                                                    <StackPanel>
                                                        <TextBlock FontWeight="SemiBold"
                                                                   Text="{Binding NomeTransformador}"/>

                                                        <TextBlock Margin="0,6,0,0"
                                                                   Foreground="#7A7A7A"
                                                                   Text="{Binding CaminhoTransformador}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Button Grid.Row="4"
                                        Height="42"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Content="Atualizar Transformadores"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- VERSION HISTORY -->
                    <Border Grid.Row="4"
                            Padding="20"
                            Background="White"
                            CornerRadius="20"
                            BorderBrush="#E6E6E6"
                            BorderThickness="1">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="20"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                                Kind="History"
                                                Width="22"
                                                Height="22"
                                                Foreground="#5B5CEB"/>

                                <TextBlock Margin="12,0,0,0"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Text="Histórico de Versões"/>
                            </StackPanel>

                            <DataGrid Grid.Row="2"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      BorderThickness="0"
                                      HeadersVisibility="Column"
                                      RowBackground="Transparent"
                                      AlternatingRowBackground="#FAFAFA">

                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Componente" Binding="{Binding Component}" Width="*"/>
                                    <DataGridTextColumn Header="Versão Atual" Binding="{Binding Version}" Width="160"/>
                                    <DataGridTextColumn Header="Atualizado Em" Binding="{Binding UpdatedAt}" Width="220"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                </Grid>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</UserControl>
