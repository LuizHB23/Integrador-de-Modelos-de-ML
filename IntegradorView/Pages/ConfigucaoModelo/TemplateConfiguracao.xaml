<UserControl x:Class="IntegradorView.Pages.ConfigucaoModelo.TemplateConfiguracao"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:IntegradorView.Pages.ConfigucaoModelo"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vmsconfiguracao="clr-namespace:IntegradorViewModel.Pages.ConfiguracaoModelo;assembly=IntegradorViewModel"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Background="{DynamicResource MaterialDesignPaper}">
    <Grid>
        <DockPanel>
            <Grid DockPanel.Dock="Top">
                <materialDesign:Card>
                    <StackPanel>
                        <TextBlock Text="Seu Modelo" 
                                    Padding="20,5" 
                                    FontSize="20" 
                                    Foreground="Gray"/>
                        
                        <StackPanel Orientation="Horizontal"
                            Grid.Row="0"
                            Margin="0,30"
                            HorizontalAlignment="Center">
                            <RadioButton x:Name="RbConfiguracoes" 
                                 Style="{StaticResource MaterialDesignTabRadioButton}"
                                 FontSize="18"
                                 Content="Configurações do Modelo" 
                                 IsChecked="True" 
                                 Margin="0,0,10,0"/>

                            <RadioButton x:Name="RbMetricas" 
                                 Style="{StaticResource MaterialDesignTabRadioButton}"
                                 FontSize="18"
                                 Content="Configurações das Métricas" 
                                 IsChecked="False"/>

                            <RadioButton x:Name="RbHistorico" 
                                 Style="{StaticResource MaterialDesignTabRadioButton}"
                                 FontSize="18"
                                 Content="Histórico Predições" 
                                 IsChecked="False"/>
                        </StackPanel>
                    </StackPanel>
                </materialDesign:Card>
            </Grid>

            <ContentControl>
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChecked, ElementName=RbConfiguracoes}" Value="True">
                                <Setter Property="Content">
                                    <Setter.Value>
                                        <local:ConfiguracaoModelo>
                                            <local:ConfiguracaoModelo.DataContext>
                                                <vmsconfiguracao:ConfiguracaoModeloViewModel/>
                                            </local:ConfiguracaoModelo.DataContext>
                                        </local:ConfiguracaoModelo>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>

                            <DataTrigger Binding="{Binding IsChecked, ElementName=RbMetricas}" Value="True">
                                <Setter Property="Content">
                                    <Setter.Value>
                                        <local:MetricasModelo>
                                            <local:MetricasModelo.DataContext>
                                                <vmsconfiguracao:MetricasModeloViewModel/>
                                            </local:MetricasModelo.DataContext>
                                        </local:MetricasModelo>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>

                            <DataTrigger Binding="{Binding IsChecked, ElementName=RbHistorico}" Value="True">
                                <Setter Property="Content">
                                    <Setter.Value>
                                        <local:HistoricoPredicoes>
                                            <local:HistoricoPredicoes.DataContext>
                                                <vmsconfiguracao:HistoricoPredicoesViewModel/>
                                            </local:HistoricoPredicoes.DataContext>
                                        </local:HistoricoPredicoes>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
        </DockPanel>
    </Grid>
</UserControl>
