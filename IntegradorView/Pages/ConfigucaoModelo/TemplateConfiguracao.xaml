<UserControl x:Class="IntegradorView.Pages.ConfigucaoModelo.TemplateConfiguracao"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:IntegradorView.Pages.ConfigucaoModelo"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vmsconfiguracao="clr-namespace:IntegradorViewModel.Pages.ConfiguracaoModelo;assembly=IntegradorViewModel"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Background="{DynamicResource MaterialDesignPaper}">

    <UserControl.Resources>
        <DataTemplate DataType="{x:Type vmsconfiguracao:ConfiguracaoModeloViewModel}">
            <local:ConfiguracaoModelo />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vmsconfiguracao:MetricasModeloViewModel}">
            <local:MetricasModelo />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vmsconfiguracao:HistoricoPredicoesViewModel}">
            <local:HistoricoPredicoes />
        </DataTemplate>
    </UserControl.Resources>
    
    <Grid>
        <DockPanel>
            <Grid DockPanel.Dock="Top">
                <materialDesign:Card>
                    <StackPanel>
                        <TextBlock Text="Seu Modelo"
                                   HorizontalAlignment="Center"
                                   Padding="20,5" 
                                   FontSize="30"
                                   FontWeight="Bold"/>
                        
                        <StackPanel Orientation="Horizontal"
                            Grid.Row="0"
                            Margin="0,30"
                            HorizontalAlignment="Center">
                            <RadioButton x:Name="RbConfiguracoes" 
                                 Style="{StaticResource MaterialDesignTabRadioButton}"
                                 FontSize="18"
                                 Content="Configurações do Modelo" 
                                 IsChecked="True" 
                                 Margin="0,0,10,0"/>

                            <RadioButton x:Name="RbMetricas" 
                                 Style="{StaticResource MaterialDesignTabRadioButton}"
                                 FontSize="18"
                                 Content="Configurações das Métricas" 
                                 IsChecked="False"/>

                            <RadioButton x:Name="RbHistorico" 
                                 Style="{StaticResource MaterialDesignTabRadioButton}"
                                 FontSize="18"
                                 Content="Histórico Predições" 
                                 IsChecked="False"/>
                        </StackPanel>
                    </StackPanel>
                </materialDesign:Card>
            </Grid>

            <ContentControl>
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="Content" Value="{Binding ConfigVM}" />

                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ElementName=RbMetricas, Path=IsChecked}" Value="True">
                                <Setter Property="Content" Value="{Binding MetricasVM}" />
                            </DataTrigger>

                            <DataTrigger Binding="{Binding ElementName=RbHistorico, Path=IsChecked}" Value="True">
                                <Setter Property="Content" Value="{Binding HistoricoVM}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
        </DockPanel>
    </Grid>
</UserControl>
