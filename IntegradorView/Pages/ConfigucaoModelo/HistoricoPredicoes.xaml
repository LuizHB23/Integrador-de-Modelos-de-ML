<UserControl x:Class="IntegradorView.Pages.ConfigucaoModelo.HistoricoPredicoes"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:IntegradorView.Pages.ConfigucaoModelo"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             Background="{DynamicResource MaterialDesignPaper}">
    <Grid>
        <TextBlock Text="Histórico de Alterações" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,15"/>
        <materialDesign:Card Padding="10">
            <DataGrid ItemsSource="{Binding HistoricoLogs}" AutoGenerateColumns="False" IsReadOnly="True" Background="White">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Data" Binding="{Binding DataLog}" Width="150"/>
                    <DataGridTextColumn Header="Versão" Binding="{Binding VersaoLog}" Width="100"/>
                    <DataGridTextColumn Header="Ação" Binding="{Binding AcaoLog}" Width="*"/>
                    <DataGridTextColumn Header="Usuário" Binding="{Binding UsuarioLog}" Width="150"/>
                </DataGrid.Columns>
            </DataGrid>
        </materialDesign:Card>
    </Grid>
</UserControl>
