<UserControl x:Class="IntegradorView.Pages.PrincipalModelo.Home"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:IntegradorView.Pages.PrincipalModelo"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Background="{DynamicResource MaterialDesignPaper}">

    <UserControl.Resources>
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModelCardStyle" TargetType="Button">
            <Setter Property="Width" Value="220"/>
            <Setter Property="Margin" Value="0,0,20,20"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" BorderBrush="#DDD" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1"/>
                            </Border.Effect>
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="30">
                <TextBlock Text="Seus Modelos" FontSize="28" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,20"/>

                <ItemsControl ItemsSource="{Binding ListaModelos}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" Margin="0,20"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                        
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <Button Style="{StaticResource ModelCardStyle}"
                                        Command="{Binding DataContext.NavigateToPreparacaoModeloCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        Cursor="Hand"
                                        Width="345"
                                        Height="300">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="180"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <Border Grid.Row="0" x:Name="BotaoModelo" Background="#E0E0E0" CornerRadius="8,8,0,0">
                                            <TextBlock Text="📊" FontSize="40" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <StackPanel Grid.Row="1" VerticalAlignment="Top">
                                            <Grid Margin="10,10,10,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Text="{Binding NomeModelo}" 
                                                            FontWeight="Bold" 
                                                            FontSize="26" 
                                                            TextTrimming="CharacterEllipsis"/>

                                                <Border Grid.Column="1" 
                                                        Background="#ECEFF1" 
                                                        CornerRadius="10" 
                                                        Padding="8,2" 
                                                        VerticalAlignment="Center"
                                                        Margin="5,0,0,0">
                                                    <TextBlock Text="Testando"
                                                                FontSize="16" 
                                                                FontWeight="SemiBold" 
                                                                Foreground="#546E7A"/>
                                                </Border>
                                            </Grid>

                                            <TextBlock Text="{Binding Tipo}" 
                                                        Padding="20,5" 
                                                        FontSize="20" 
                                                        Foreground="Gray"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>

                                <Button Content="Configuração do Modelo"
                                        HorizontalAlignment="Left"
                                        Style="{StaticResource MaterialDesignOutlinedDarkButton}"
                                        Margin="0,0,0,40"
                                        Height="40"
                                        Width="345"/>
                        </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!--<Button Style="{StaticResource ModelCardStyle}"
                        Command="{Binding NavigateToPreparacaoModeloCommand}"
                        Cursor="Hand"
                        Width="350"
                        Height="300"
                        Margin="10,0">
                    <StackPanel>
                        <Border Height="180" Background="#E0E0E0" CornerRadius="8,8,0,0">
                            <TextBlock Text="🧠" FontSize="40" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Modelo Beta" Padding="15,10,15,5" FontWeight="Bold" FontSize="30"/>
                        <TextBlock Text="Rede Neural" Padding="15,0,15,15" FontSize="24" Foreground="Gray"/>
                    </StackPanel>
                </Button>-->
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
