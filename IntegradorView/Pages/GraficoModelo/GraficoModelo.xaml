<Page x:Class="IntegradorView.Pages.GraficoModelo.GraficoModelo"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:IntegradorView.Pages.GraficoModelo"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="GraficoClassificacao"
      Background="{DynamicResource MaterialDesignPaper}">

    <Grid Margin="20">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="10">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ========================= -->
                <!-- Upload de Arquivos -->
                <!-- ========================= -->

                <materialDesign:Card Grid.Row="0" Padding="16" Margin="0 0 0 16">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Arquivo de Predição -->

                        <StackPanel Grid.Column="0" Margin="8">
                            <TextBlock Text="Arquivo de Predição"
                                   FontWeight="Bold"
                                   Margin="0 0 0 6"/>

                            <TextBox
                            materialDesign:HintAssist.Hint="Selecione o arquivo de predição"/>

                            <Button
                            Margin="0 8 0 0"
                            Content="Selecionar Arquivo"/>
                        </StackPanel>

                        <!-- Arquivo Real -->

                        <StackPanel Grid.Column="1" Margin="8">
                            <TextBlock Text="Arquivo de Valores Reais"
                                   FontWeight="Bold"
                                   Margin="0 0 0 6"/>

                            <TextBox
                            materialDesign:HintAssist.Hint="Selecione o arquivo real"/>

                            <Button
                            Margin="0 8 0 0"
                            Content="Selecionar Arquivo"/>
                        </StackPanel>

                        <!-- Tipo de Modelo -->

                        <StackPanel Grid.Column="2" Margin="8">

                            <TextBlock Text="Seu Modelo"
                                   FontWeight="Bold"
                                   Margin="0 0 0 6"/>

                            <ComboBox>
                                <ComboBoxItem Content="Regressão"/>
                                <ComboBoxItem Content="Classificação"/>
                                <ComboBoxItem Content="Clustering"/>
                            </ComboBox>

                            <Button
                            Margin="0 8 0 0"
                            Content="Avaliar Modelo"
                            Style="{StaticResource MaterialDesignRaisedButton}"/>
                        </StackPanel>

                    </Grid>

                </materialDesign:Card>

                <!-- ========================= -->
                <!-- Métricas -->
                <!-- ========================= -->

                <materialDesign:Card Grid.Row="1" Padding="16" Margin="0 0 0 16">

                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                            Text="Métricas"
                            FontSize="18"
                            FontWeight="Bold"
                            Margin="10"/>

                            <ComboBox Margin="30,0" 
                                      materialDesign:HintAssist.Hint="Saída" 
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                      FontSize="14"
                                      Width="Auto">
                                <ComboBoxItem Content="1"/>
                            </ComboBox>

                        </StackPanel>

                        <UniformGrid Columns="4">

                            <materialDesign:Card Margin="6" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Accuracy"/>
                                    <TextBlock Text="0.00" FontSize="20"/>
                                </StackPanel>
                            </materialDesign:Card>

                            <materialDesign:Card Margin="6" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Precision"/>
                                    <TextBlock Text="0.00" FontSize="20"/>
                                </StackPanel>
                            </materialDesign:Card>

                            <materialDesign:Card Margin="6" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Recall"/>
                                    <TextBlock Text="0.00" FontSize="20"/>
                                </StackPanel>
                            </materialDesign:Card>

                            <materialDesign:Card Margin="6" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="F1 Score"/>
                                    <TextBlock Text="0.00" FontSize="20"/>
                                </StackPanel>
                            </materialDesign:Card>

                        </UniformGrid>

                    </StackPanel>

                </materialDesign:Card>

                <!-- ========================= -->
                <!-- Área de Gráficos -->
                <!-- ========================= -->

                <materialDesign:Card Grid.Row="2" Padding="16">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock
                        Text="Gráficos"
                        FontSize="18"
                        FontWeight="Bold"
                        Margin="0 0 0 10"/>

                        <Grid Grid.Row="1">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <!-- Gráfico 1 -->

                            <Border Grid.Column="0"
                                Margin="8"
                                Background="#EEEEEE"
                                CornerRadius="6">
                                <TextBlock
                                Text="Gráfico 1"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"/>
                            </Border>

                            <!-- Gráfico 2 -->

                            <Border Grid.Column="1"
                                Margin="8"
                                Background="#EEEEEE"
                                CornerRadius="6">
                                <TextBlock
                                Text="Gráfico 2"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"/>
                            </Border>

                        </Grid>

                    </Grid>

                </materialDesign:Card>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
