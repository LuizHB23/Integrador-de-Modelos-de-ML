<UserControl x:Class="IntegradorView.Pages.PredicaoModelo.ResultadoPredicao"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:IntegradorView.Pages.PredicaoModelo"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Background="{DynamicResource MaterialDesignPaper}">

    <Grid Margin="30"
          Width="Auto"
          Height="Auto">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Resultados do Processamento"
                   HorizontalAlignment="Center"
                   Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                   Margin="10"
                   FontSize="28"/>


        <materialDesign:Card Grid.Row="1" 
                             UniformCornerRadius="10"
                             Margin="0,0,0,20"
                             Width="800">
            <GroupBox Header="Preview das Predições" 
                      materialDesign:ColorZoneAssist.Mode="PrimaryMid"
                      Margin="0">
                <GroupBox.HeaderTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" 
                                   HorizontalAlignment="Center" 
                                   Width="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}, Path=ActualWidth}"
                                   TextAlignment="Center"
                                   FontWeight="Bold"/>
                    </DataTemplate>
                </GroupBox.HeaderTemplate>
                <DataGrid x:Name="GridResultados" 
                          ItemsSource="{Binding ListaPredicoes}"
                          AutoGenerateColumns="True"
                          IsReadOnly="True"
                          Style="{StaticResource MaterialDesignDataGrid}">
                </DataGrid>
            </GroupBox>
        </materialDesign:Card>

        <Grid Grid.Row="2" 
              Width="800">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <materialDesign:Card Grid.Column="0" 
                                 Margin="0,0,10,0" 
                                 UniformCornerRadius="10"
                                 Height="90">
                
                <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Center">
                    
                    <materialDesign:PackIcon Kind="Timer" 
                                             Width="40" 
                                             Height="40" 
                                             VerticalAlignment="Center"/>
                    
                    <StackPanel Margin="20,0,0,0"
                                VerticalAlignment="Center">
                        <TextBlock Text="Tempo de Processamento" 
                                   FontSize="12" />
                        
                        <TextBlock x:Name="TxtTimer" 
                                   Text="00:00:42.15" 
                                   FontSize="24"/>
                    </StackPanel>
                </StackPanel>
            </materialDesign:Card>

            <materialDesign:Card Grid.Column="1"
                                 Margin="10,0,0,0"
                                 UniformCornerRadius="10"
                                 Height="90">
                
                <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Center">
                    
                    <materialDesign:PackIcon Kind="Printer"
                                             Width="40" 
                                             Height="40" 
                                             VerticalAlignment="Center"/>

                    <StackPanel Margin="10">
                        <TextBlock Text="Exportar Resultados"
                                   Margin="5"
                                   FontSize="18"/>
                        
                        <Button Content="Exportar CSV"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Width="170"/>
                    </StackPanel>
                </StackPanel>
            </materialDesign:Card>

            <materialDesign:Card Grid.Column="2"
                     Margin="10,0,0,0"
                     UniformCornerRadius="10"
                     Height="90">

                <StackPanel Orientation="Horizontal" 
                HorizontalAlignment="Center">

                    <materialDesign:PackIcon Kind="Printer"
                                 Width="40" 
                                 Height="40" 
                                 VerticalAlignment="Center"/>

                    <StackPanel Margin="10">
                        <TextBlock Text="Exportar Erros"
                                   Margin="5"
                                   FontSize="18"/>

                        <Button Content="Exportar CSV" 
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Width="170"/>
                    </StackPanel>
                </StackPanel>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
