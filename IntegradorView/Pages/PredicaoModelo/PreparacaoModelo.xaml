                                <TextBox Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                                         materialDesign:HintAssist.Hint="Ex: 3500" FontSize="16"/>
                            </StackPanel>
                        </materialDesign:Card>

                        <materialDesign:Card Width="220" Margin="0,0,15,15" Padding="15" UniformCornerRadius="10">
                            <StackPanel>
                                <TextBlock Text="ESCOLARIDADE" FontSize="11" FontWeight="Bold" Foreground="Gray" Margin="0,0,0,5"/>
                                <ComboBox materialDesign:HintAssist.Hint="Selecione" Margin="0,4,0,0">
                                    <ComboBoxItem Content="Superior"/>
                                    <ComboBoxItem Content="Médio"/>
