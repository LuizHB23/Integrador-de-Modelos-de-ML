<UserControl x:Class="IntegradorView.Pages.PredicaoModelo.PreparacaoModelo"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:IntegradorView.Pages.PredicaoModelo"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Background="{DynamicResource MaterialDesignPaper}">

    <Grid Margin="30"
          HorizontalAlignment="Center"
          VerticalAlignment="Top">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   Text="Executar Predição" 
                   Style="{StaticResource MaterialDesignHeadline6TextBlock}" 
                   Margin="0,0,0,20"
                   HorizontalAlignment="Center"
                   FontSize="28" 
                   FontWeight="ExtraBold"/>

        <StackPanel Grid.Row="1" 
                    Orientation="Horizontal" 
                    Margin="0,0,0,30"
                    HorizontalAlignment="Center">
            <RadioButton x:Name="RbManual" 
                         Style="{StaticResource MaterialDesignTabRadioButton}"
                         FontSize="18"
                         Content="Carregar Arquivo CSV" 
                         IsChecked="True" 
                         Margin="0,0,10,0"/>
            
            <RadioButton x:Name="RbArquivo" 
                         Style="{StaticResource MaterialDesignTabRadioButton}"
                         FontSize="18"
                         Content="Predição Manual" 
                         IsChecked="False"/>
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <Grid Cursor="">
                <StackPanel>
                    <materialDesign:Card Width="500" HorizontalAlignment="Left" Padding="30" UniformCornerRadius="15">
                        <StackPanel>
                            <TextBlock Text="Upload de Lote" 
                                       Margin="10"
                                       Style="{StaticResource MaterialDesignHeadline6TextBlock}"/>
                            <TextBlock Text="Selecione um arquivo .csv para realizar predições em massa." 
                                       FontSize="14"
                                       Margin="0,10" 
                                       TextWrapping="Wrap"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox materialDesign:HintAssist.Hint="Caminho do arquivo..." 
                                         IsReadOnly="True"
                                         VerticalAlignment="Center"
                                         Margin="0,10,10,10"
                                         FontSize="14"/>
                                <Button Grid.Column="1" 
                                        Content="BUSCAR" 
                                        Command="{Binding CarregarArquivoDadosCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"/>
                            </Grid>

                            <Button x:Name="BotaoProcessamento"
                                    Content="Iniciar Processamento" 
                                    Margin="0,30,0,0" 
                                    Height="45" 
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    Command="{Binding NavigateToResultadoPredicaoCommand}"
                                    Cursor="Hand"/>
                        </StackPanel>
                    </materialDesign:Card>
                </StackPanel>
                
                <!--<StackPanel>
                    <WrapPanel Orientation="Horizontal">
                        <materialDesign:Card Width="220" Margin="0,0,15,15" Padding="15" UniformCornerRadius="10">
