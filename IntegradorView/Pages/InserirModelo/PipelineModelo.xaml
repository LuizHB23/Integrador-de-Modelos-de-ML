<UserControl x:Class="IntegradorView.Pages.InserirModelo.PipelineModelo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:local="clr-namespace:IntegradorView.Pages.InserirModelo"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d" 
        d:DesignHeight="450" d:DesignWidth="800"
        Background="{DynamicResource MaterialDesignPaper}">

    <DockPanel Margin="20,0,20,20">

        <Grid DockPanel.Dock="Bottom">
            <StackPanel Orientation="Horizontal"
                        Margin="0,15,0,0"
                        HorizontalAlignment="Right">

                <Button x:Name="BotaoCancelar" 
                        Content="Cancelar"
                        Style="{StaticResource MaterialDesignOutlinedButton}" 
                        Width="120"
                        Margin="10,0"
                        Cursor="Hand"/>

                <Button x:Name="BotaoFinalizar"
                        Content="Finalizar" 
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Width="120"
                        Margin="10,0"
                        Cursor="Hand"/>
            </StackPanel>
        </Grid>


        <Grid Margin="10,10,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="7*"/>
                    <RowDefinition Height="4*"/>
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    
                    <materialDesign:Card 
                        Grid.Column="0"
                        Width="Auto"
                        Height="Auto"
                        VerticalAlignment="Stretch" 
                        HorizontalAlignment="Stretch" 
                        Margin="0,10,10,10"
                        UniformCornerRadius="10">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <materialDesign:ColorZone Mode="PrimaryMid" 
                                                      Padding="16" 
                                                      CornerRadius="8,8,0,0"
                                                      Grid.Row="0">
                                <StackPanel Orientation="Horizontal" 
                                            VerticalAlignment="Center">

                                    <materialDesign:PackIcon Kind="Function" 
                                                             Width="24" 
                                                             Height="24" 
                                                             VerticalAlignment="Center" 
                                                             Margin="0,0,10,0"/>

                                    <TextBlock Text="Escolher Função" 
                                    Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                    VerticalAlignment="Center"
                                    Margin="0,0,20,0"/>
                                </StackPanel>

                            </materialDesign:ColorZone>

                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          Grid.Row="1">
                                <Grid Margin="16">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding Steps}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <ComboBox Margin="0,8"
                                                              Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                                                              materialDesign:HintAssist.Hint="{Binding Hint}"
                                                              materialDesign:TextFieldAssist.HasClearButton="True"
                                                              ItemsSource="{Binding Options}"
                                                              SelectedItem="{Binding SelectedOption, Mode=TwoWay}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </ScrollViewer>
                            <StackPanel Orientation="Horizontal"
                                        Grid.Row="2">
                                
                                <Button Content="Anterior"
                                        Height="40"
                                        FontSize="14"
                                        Margin="20,10,0,10"
                                        FontWeight="Bold"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Cursor="Hand"/>
                                
                                <Button Content="Próximo"
                                        Height="40"
                                        Margin="20,10"
                                        FontSize="14"
                                        FontWeight="Bold"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Cursor="Hand"/>
                            </StackPanel>
                        </Grid>
                    </materialDesign:Card>

                    <materialDesign:Card Grid.Column="1"
                                         Width="Auto"
                                         Height="Auto"
                                         VerticalAlignment="Stretch" 
                                         HorizontalAlignment="Stretch" 
                                         Margin="10,10,0,10"
                                         UniformCornerRadius="10">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <materialDesign:ColorZone Mode="PrimaryMid" Padding="16" CornerRadius="8,8,0,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="Settings" Width="24" Height="24" 
                                                 VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBlock Text="{Binding FuncaoSelecionada, FallbackValue='Configurar Função'}" 
                                                   Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,20,0"/>
                                </StackPanel>

                            </materialDesign:ColorZone>

                            <TextBlock Text="Parâmetros de Processamento"
                                               Grid.Row="1"
                                               Style="{StaticResource MaterialDesignSubtitle1TextBlock}" 
                                               Margin="16"/>
                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="20">
                                <TextBox Grid.Row="2"
                                     Text="{Binding ScriptCodigo, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     FontFamily="Consolas" 
                                     FontSize="14"
                                     AcceptsReturn="True" 
                                     AcceptsTab="True"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     TextWrapping="Wrap"
                                     Margin="16,5,16,16"
                                     VerticalAlignment="Stretch"
                                     materialDesign:HintAssist.Hint="Configure sua função aqui"
                                     MinHeight="200"
                                     MaxWidth="235">
                                    
                                </TextBox>
                            </ScrollViewer>

                            <Button Content="ADICIONAR"
                                    Grid.Row="3"
                                    HorizontalAlignment="Right"
                                    Height="40"
                                    Margin="0,0,20,10"
                                    FontSize="14"
                                    FontWeight="Bold"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    Cursor="Hand"/>

                        </Grid>
                    </materialDesign:Card>
                </Grid>
                <materialDesign:Card Grid.Row="1"
                                     UniformCornerRadius="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <materialDesign:ColorZone Mode="PrimaryMid" 
                                                  CornerRadius="8,0,0,8"
                                                  Grid.Column="0"
                                                  VerticalAlignment="Stretch">
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center">

                                <TextBlock Text="Pipeline" 
                                           Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                           HorizontalAlignment="Center"
                                           Width="Auto"
                                           Margin="20,5"/>

                                <Button Content="Carregar"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Foreground="White"
                                        BorderBrush="White"
                                        Grid.Row="3"
                                        HorizontalAlignment="Right"
                                        Height="40"
                                        Margin="20"
                                        FontSize="14"
                                        FontWeight="Bold"
                                        Cursor="Hand"/>
                            </StackPanel>
                        </materialDesign:ColorZone>

                        <Border Grid.Column="1"
                                BorderThickness="0.5"
                                Margin="20"
                                BorderBrush="Black"
                                CornerRadius="5">

                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="10">
                                    <Border Margin="10"
                                            BorderThickness="0.5"
                                            BorderBrush="Black"
                                            MinHeight="40"
                                            CornerRadius="5">

                                        <Grid>

                                            <StackPanel Orientation="Horizontal">
                                                <ComboBox Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                                          materialDesign:TextFieldAssist.TextFieldCornerRadius="10"
                                                          BorderBrush="#D1D1D1"
                                                          Margin="10"
                                                          Width="Auto"
                                                          Height="Auto"
                                                          Grid.Column="0">
                                                    <ComboBoxItem Content="1"
                                                                  Width="Auto"/>
                                                </ComboBox>

                                                <Rectangle Width="1"
                                                           Grid.Column="1"
                                                           Fill="#D1D1D1" 
                                                           Height="Auto"
                                                           Margin="0,10"/>

                                                <TextBlock Style="{StaticResource MaterialDesignBody1TextBlock}"
                                                           FontWeight="DemiBold"
                                                           HorizontalAlignment="Left"
                                                           VerticalAlignment="Center"
                                                           Margin="10,0"
                                                           MinHeight="40"
                                                           Text="GroupBy()"/>


                                            </StackPanel>

                                            <Button  Style="{StaticResource MaterialDesignOutlinedButton}"
                                                     Grid.Row="3"
                                                     BorderBrush="White"
                                                     HorizontalAlignment="Right"
                                                     Height="40"
                                                     Width="55"
                                                     Margin="0,10"
                                                     Cursor="Hand">

                                                <materialDesign:PackIcon Kind="Trash" 
                                                                         VerticalAlignment="Center"
                                                                         Width="Auto" 
                                                                         Height="Auto"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </materialDesign:Card>
            </Grid>

            <materialDesign:Card Grid.Column="2"
                                 UniformCornerRadius="10"
                                 Margin="20,10,0,0">
                
                <GroupBox Header="PREVIEW DOS DADOS"
                          materialDesign:ColorZoneAssist.Mode="PrimaryMid"
                          materialDesign:ColorZoneAssist.Foreground="White">
                    <GroupBox.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" 
                               HorizontalAlignment="Center" 
                               Width="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}, Path=ActualWidth}"
                               TextAlignment="Center"
                               FontWeight="Bold"/>
                        </DataTemplate>
                    </GroupBox.HeaderTemplate>

                    <DataGrid x:Name="GridPreview" 
                                AutoGenerateColumns="True" 
                                IsReadOnly="True"
                                CanUserAddRows="False"
                                VerticalScrollBarVisibility="Auto"
                                Style="{StaticResource MaterialDesignDataGrid}">
                    </DataGrid>
                </GroupBox>
            </materialDesign:Card>

        </Grid>
    </DockPanel>
</UserControl>
