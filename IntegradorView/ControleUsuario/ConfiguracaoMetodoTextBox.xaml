<UserControl x:Class="IntegradorView.ControleUsuario.ConfiguracaoMetodoTextBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:IntegradorView.ControleUsuario"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <TextBox  Text="{Binding ScriptCodigo, UpdateSourceTrigger=PropertyChanged}"
                  Style="{StaticResource MaterialDesignOutlinedTextBox}"
                  FontFamily="Consolas" 
                  FontSize="14"
                  AcceptsReturn="True" 
                  AcceptsTab="True"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto"
                  TextWrapping="Wrap"
                  Margin="16,16,16,16"
                  VerticalAlignment="Stretch"
                  materialDesign:HintAssist.Hint="Configure sua função aqui"
                  MinHeight="200"
                  Width="548">   

        </TextBox>
    </Grid>
</UserControl>
