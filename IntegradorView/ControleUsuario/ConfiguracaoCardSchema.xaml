<UserControl x:Class="IntegradorView.ControleUsuario.ConfiguracaoCardSchema"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:IntegradorView.ControleUsuario"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <StackPanel Margin="5">
            <Grid>
                <materialDesign:Card x:Name="PosicaoSchema"
                             Margin="7" Padding="12"                                                    
                             materialDesign:ElevationAssist.Elevation="Dp2"
                             UniformCornerRadius="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ComboBox materialDesign:HintAssist.Hint="Tipo"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                  SelectedItem="{Binding Posicao}"
                                  ItemsSource="{Binding OpcoesPosicao}"
                                  materialDesign:TextFieldAssist.TextFieldCornerRadius="10"
                                  Margin="10, 10, 20, 10"
                                  Width="70"
                                  Height="50"
                                  Grid.Column="0"/>

                        <Rectangle Width="1"
                                   Grid.Column="1"
                                   Fill="#D1D1D1"
                                   Height="Auto"
                                   Margin="10"/>


                        <WrapPanel Grid.Column="2"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center">
                            <StackPanel Margin="5, 10" Width="250">
                                <TextBox materialDesign:HintAssist.Hint="Coluna" 
                                         Text="{Binding NomeColuna}"
                                         IsReadOnly="True"
                                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                         Width="250"
                                         FontSize="18"/>
                            </StackPanel>

                            <StackPanel Margin="10,5" MinWidth="50">
                                <TextBlock Text="Categórico?"
                                   VerticalAlignment="Center" Margin="20,0,20,5"
                                   Style="{StaticResource MaterialDesignBody2TextBlock}"/>

                                <ToggleButton Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                              IsChecked="{Binding Categorico}"
                                              VerticalAlignment="Center"
                                              Margin="20,0"
                                              ToolTip="Marque se a coluna for uma categoria"/>
                            </StackPanel>

                            <StackPanel Margin="5,10" MinWidth="185">
                                <ComboBox materialDesign:HintAssist.Hint="Finalidade"
                                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                          SelectedValuePath="Content"
                                          SelectedValue="{Binding Finalidade}"
                                          materialDesign:TextFieldAssist.TextFieldCornerRadius="10"
                                          Width="200"
                                          Height="50">
                                    <ComboBoxItem Content="Feature"/>
                                    <ComboBoxItem Content="Label (Target)"/>
                                    <ComboBoxItem Content="Ignore"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Margin="10" MinWidth="185">
                                <ComboBox materialDesign:HintAssist.Hint="Tipo"
                                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                          SelectedValuePath="Content"
                                          SelectedValue="{Binding Tipo}"
                                          materialDesign:TextFieldAssist.TextFieldCornerRadius="10"
                                          Width="200"
                                          Height="50">
                                    <ComboBoxItem Content="Single"/>
                                    <ComboBoxItem Content="String"/>
                                    <ComboBoxItem Content="Boolean"/>
                                    <ComboBoxItem Content="DateTime"/>
                                </ComboBox>
                            </StackPanel>
                        </WrapPanel>

                        <Button  Style="{StaticResource MaterialDesignOutlinedButton}"
                                 Command="{Binding FoiRemovidoCommand}"
                                 Grid.Column="3"
                                 HorizontalAlignment="Right"
                                 Height="40"
                                 Width="55"
                                 Margin="0,10"
                                 Cursor="Hand">

                            <materialDesign:PackIcon Kind="Trash" 
                                             VerticalAlignment="Center"
                                             Width="Auto" 
                                             Height="Auto"/>
                        </Button>
                    </Grid>
                </materialDesign:Card>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
