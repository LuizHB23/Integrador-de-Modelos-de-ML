<UserControl x:Class="IntegradorView.ControleUsuario.CaixaDeDownload"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:IntegradorView.ControleUsuario"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <materialDesign:Snackbar x:Name="MeuSnackbar"
                                 MessageQueue="{Binding NotificationService.Queue}"
                                 VerticalAlignment="Bottom"
                                 HorizontalAlignment="Right">
            <materialDesign:Snackbar.Resources>
                <Style TargetType="{x:Type materialDesign:SnackbarMessage}">
                    <Setter Property="ContentTemplate">
                        <Setter.Value>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Download" 
                                                   Width="20" Height="20"
                                                   Margin="0,0,12,0" 
                                                   VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding}" 
                                     VerticalAlignment="Center" 
                                     FontSize="14"/>
                                </StackPanel>
                            </DataTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </materialDesign:Snackbar.Resources>
        </materialDesign:Snackbar>
    </Grid>
</UserControl>
