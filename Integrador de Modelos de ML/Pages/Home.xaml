<Page x:Class="Integrador_de_Modelos_de_ML.Pages.Home"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Integrador_de_Modelos_de_ML.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Home">

    <Page.Resources>
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModelCardStyle" TargetType="Button">
            <Setter Property="Width" Value="220"/>
            <Setter Property="Margin" Value="0,0,20,20"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" BorderBrush="#DDD" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1"/>
                            </Border.Effect>
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="30">
                <TextBlock Text="Seus Modelos" FontSize="24" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,20"/>

                <WrapPanel Orientation="Horizontal">

                    <Button Style="{StaticResource ModelCardStyle}">
                        <StackPanel>
                            <Border Height="120" Background="#E0E0E0" CornerRadius="8,8,0,0">
                                <TextBlock Text="📊" FontSize="40" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Modelo Alpha" Padding="15,10,15,5" FontWeight="Bold" FontSize="16"/>
                            <TextBlock Text="Regressão Linear" Padding="15,0,15,15" FontSize="12" Foreground="Gray"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource ModelCardStyle}">
                        <StackPanel>
                            <Border Height="120" Background="#E0E0E0" CornerRadius="8,8,0,0">
                                <TextBlock Text="🧠" FontSize="40" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Modelo Beta" Padding="15,10,15,5" FontWeight="Bold" FontSize="16"/>
                            <TextBlock Text="Rede Neural" Padding="15,0,15,15" FontSize="12" Foreground="Gray"/>
                        </StackPanel>
                    </Button>

                </WrapPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
