<Page x:Class="Integrador_de_Modelos_de_ML.Pages.PipelineModelo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:local="clr-namespace:Integrador_de_Modelos_de_ML"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d" 
        d:DesignHeight="450" d:DesignWidth="800"
        Title="InserirModelo"
        Background="{DynamicResource MaterialDesignPaper}">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <GroupBox Header="PREVIEW DOS DADOS"
                materialDesign:ColorZoneAssist.Mode="PrimaryDark"
                materialDesign:ColorZoneAssist.Foreground="White">
            <GroupBox.HeaderTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" 
                       HorizontalAlignment="Center" 
                       Width="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}, Path=ActualWidth}"
                       TextAlignment="Center"
                       FontWeight="Bold"/>
                </DataTemplate>
            </GroupBox.HeaderTemplate>
            
            <DataGrid x:Name="GridPreview" 
                        AutoGenerateColumns="True" 
                        IsReadOnly="True"
                        CanUserAddRows="False"
                        VerticalScrollBarVisibility="Auto"
                        Style="{StaticResource MaterialDesignDataGrid}">
            </DataGrid>
        </GroupBox>

        <materialDesign:Card Grid.Column="1"
                    Width="Auto"
                    Height="Auto"
                    VerticalAlignment="Stretch" 
                    HorizontalAlignment="Stretch" 
                    Padding="30"
                    Margin="10"
                    UniformCornerRadius="15">
        </materialDesign:Card>
    </Grid>
</Page>
