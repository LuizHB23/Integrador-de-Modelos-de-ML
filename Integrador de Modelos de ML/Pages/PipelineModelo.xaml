<Page x:Class="Integrador_de_Modelos_de_ML.Pages.PipelineModelo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:local="clr-namespace:Integrador_de_Modelos_de_ML"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d" 
        d:DesignHeight="450" d:DesignWidth="800"
        Title="InserirModelo"
        Background="{DynamicResource MaterialDesignPaper}">

    <DockPanel Margin="20,0,20,20">

        <Button x:Name="BotaoProximo"
                DockPanel.Dock="Bottom"
                HorizontalAlignment="Right"
                Content="Finalizar" 
                Width="120"
                Margin="0,15,0,0"/>

        <Grid Margin="10,10,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="7*"/>
                    <RowDefinition Height="4*"/>
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    
                    <materialDesign:Card 
                        Grid.Column="0"
                        Width="Auto"
                        Height="Auto"
                        VerticalAlignment="Stretch" 
                        HorizontalAlignment="Stretch" 
                        Margin="0,10,10,10"
                        UniformCornerRadius="10">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <materialDesign:ColorZone Mode="PrimaryMid" 
                                                      Padding="16" 
                                                      CornerRadius="8,8,0,0"
                                                      Grid.Row="0">
                                <StackPanel Orientation="Horizontal" 
                                            VerticalAlignment="Center">

                                    <materialDesign:PackIcon Kind="Function" 
                                                             Width="24" 
                                                             Height="24" 
                                                             VerticalAlignment="Center" 
                                                             Margin="0,0,10,0"/>

                                    <TextBlock Text="Escolher Função" 
                                    Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                    VerticalAlignment="Center"
                                    Margin="0,0,20,0"/>
                                </StackPanel>

                            </materialDesign:ColorZone>

                            <ScrollViewer materialDesign:ScrollBarAssist.ButtonsVisibility="Hidden"
                                          Grid.Row="1">
                                <Grid Margin="16">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding Steps}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <ComboBox Margin="0,8"
                                              Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                                              materialDesign:HintAssist.Hint="{Binding Hint}"
                                              materialDesign:TextFieldAssist.HasClearButton="True"
                                              ItemsSource="{Binding Options}"
                                              SelectedItem="{Binding SelectedOption, Mode=TwoWay}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </ScrollViewer>
                        </Grid>
                    </materialDesign:Card>

                    <materialDesign:Card Grid.Column="1"
                                         Width="Auto"
                                         Height="Auto"
                                         VerticalAlignment="Stretch" 
                                         HorizontalAlignment="Stretch" 
                                         Margin="10,10,0,10"
                                         UniformCornerRadius="10">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <materialDesign:ColorZone Mode="PrimaryMid" Padding="16" CornerRadius="8,8,0,0">
                                <WrapPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="Settings" Width="24" Height="24" 
                                                 VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBlock Text="{Binding FuncaoSelecionada, FallbackValue='Configurar Função'}" 
                                                   Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,20,0"/>
                                    </StackPanel>

                                    <Button Content="ADICIONAR"
                                            Style="{StaticResource MaterialDesignOutlinedButton}"
                                            Foreground="White" 
                                            BorderBrush="White"
                                            Height="40" 
                                            FontSize="14"
                                            FontWeight="Bold"/>
                                </WrapPanel>
                            </materialDesign:ColorZone>

                            <TextBlock Text="Parâmetros de Processamento"
                                               Grid.Row="1"
                                               Style="{StaticResource MaterialDesignSubtitle1TextBlock}" 
                                               Margin="15"/>
                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="20">
                                <TextBox Grid.Row="1"
                                     Text="{Binding ScriptCodigo, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     FontFamily="Consolas" 
                                     FontSize="14"
                                     AcceptsReturn="True" 
                                     AcceptsTab="True"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     TextWrapping="Wrap"
                                     Margin="16"
                                     VerticalAlignment="Stretch"
                                     materialDesign:HintAssist.Hint="Configure sua função aqui"
                                     MinHeight="200"
                                     MaxWidth="330"/>
                            </ScrollViewer>
                            
                        </Grid>
                    </materialDesign:Card>
                </Grid>
                <materialDesign:Card Grid.Row="1"
                                     UniformCornerRadius="10"
                                     >
                </materialDesign:Card>
            </Grid>

            <GroupBox Header="PREVIEW DOS DADOS"
                      Grid.Column="2"
                      Margin="10,10,10,0"
                      materialDesign:ColorZoneAssist.Mode="PrimaryDark"
                      materialDesign:ColorZoneAssist.Foreground="White">
                <GroupBox.HeaderTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" 
                           HorizontalAlignment="Center" 
                           Width="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}, Path=ActualWidth}"
                           TextAlignment="Center"
                           FontWeight="Bold"/>
                    </DataTemplate>
                </GroupBox.HeaderTemplate>

                <DataGrid x:Name="GridPreview" 
                            AutoGenerateColumns="True" 
                            IsReadOnly="True"
                            CanUserAddRows="False"
                            VerticalScrollBarVisibility="Auto"
                            Style="{StaticResource MaterialDesignDataGrid}">
                </DataGrid>
            </GroupBox>
        </Grid>
    </DockPanel>
</Page>
