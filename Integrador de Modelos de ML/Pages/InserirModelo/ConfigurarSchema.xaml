<Page x:Class="Integrador_de_Modelos_de_ML.Pages.InserirModelo.ConfigurarSchema"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Integrador_de_Modelos_de_ML.Pages"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ConfigurarSchema"
      Background="{DynamicResource MaterialDesignPaper}">

    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Bottom" 
                    Orientation="Horizontal"
                    HorizontalAlignment="Right" 
                    Margin="0,15,0,0">

            <Button x:Name="BotaoCancelar" 
                    Content="Cancelar" 
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Width="120"
                    Click="BtnCancelar_Click"
                    Margin="10,0"
                    Cursor="Hand"/>
            
            <Button x:Name="BotaoProximo" 
                    Content="Próximo" 
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Width="120" 
                    Click="BtnProximo_Click"
                    Margin="10,0"
                    Cursor="Hand"/>
        </StackPanel>
        
        <!--Começo MAPEAMENTO DE COLUNAS (SCHEMA)-->

        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="10">
            <StackPanel Margin="20">
                <TextBlock Margin="25"
                    Text="Configurações De Colunas (SCHEMA)"
                    Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                    HorizontalAlignment="Center" FontSize="28"/>

                <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MaxWidth="1200">

                    <!--Começo Cartão Esquerdo-->

                    <Grid HorizontalAlignment="Stretch" Margin="0,0,0,20">
                        <materialDesign:Card MinWidth="300" UniformCornerRadius="10">
                            <StackPanel>
                                <TextBlock Margin="15,15,15,0"
                                           Text="Adicionar Coluna" 
                                           Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                           HorizontalAlignment="Center" FontSize="24"/>
                                <UniformGrid Columns="5" Margin="0,5"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Stretch">

                                    <TextBox materialDesign:HintAssist.Hint="Coluna" 
                                                Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Center"
                                                FontSize="20" 
                                                Margin="30,0"/>

                                    <ComboBox Margin="30,0" materialDesign:HintAssist.Hint="Finalidade" 
                                                Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                                                FontSize="20" 
                                                HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="Input"/>
                                        <ComboBoxItem Content="Label (Target)"/>
                                        <ComboBoxItem Content="Ignore"/>
                                    </ComboBox>

                                    <ComboBox Margin="30,0" materialDesign:HintAssist.Hint="Tipo" 
                                                Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                                                FontSize="20" 
                                                HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="Single"/>
                                        <ComboBoxItem Content="Boolean"/>
                                        <ComboBoxItem Content="DateTime"/>
                                    </ComboBox>
                                    <StackPanel Margin="5,10" MinWidth="50">
                                        <TextBlock Text="Categórico?" 
                                                   FontSize="20" 
                                                   Margin="0"
                                                   VerticalAlignment="Center" 
                                                   HorizontalAlignment="Center"
                                                   Style="{StaticResource MaterialDesignBody2TextBlock}"/>
                                        <ToggleButton Style="{StaticResource MaterialDesignSwitchToggleButton}" 
                                                            VerticalAlignment="Center"
                                                            HorizontalAlignment="Center"
                                                            Margin="5"
                                                            ToolTip="Marque se a coluna for uma categoria"/>
                                    </StackPanel>

                                    <Button Content="Adicionar"
                                            Margin="0,20,20,20"
                                            Width="Auto"
                                            Height="40"
                                            FontSize="20"
                                            HorizontalAlignment="Right"
                                            Cursor="Hand"/>
                                </UniformGrid>

                            </StackPanel>

                        </materialDesign:Card>
                    </Grid>

                    <!--Fim Cartão Esquerdo-->


                    <Grid>
                        <!--Começo Configuração Futura-->

                        <ItemsControl x:Name="ListaColunasSchema">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid x:Name="PainelMapeamento" Columns="1"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <materialDesign:Card Margin="0,5" Padding="12" materialDesign:ElevationAssist.Elevation="Dp2">
                                        <UniformGrid Columns="4">
                                            <TextBox materialDesign:HintAssist.Hint="Nome" Text="{Binding NomeColuna}" Margin="5" Style="{StaticResource MaterialDesignFloatingHintTextBox}"/>
                                            <ComboBox materialDesign:HintAssist.Hint="Finalidade" Margin="5" Style="{StaticResource MaterialDesignOutlinedComboBox}">
                                                <ComboBoxItem Content="Feature"/>
                                                <ComboBoxItem Content="Label (Target)"/>
                                            </ComboBox>
                                            <ComboBox materialDesign:HintAssist.Hint="Tipo" Margin="5" Style="{StaticResource MaterialDesignOutlinedComboBox}">
                                                <ComboBoxItem Content="Integer"/>
                                                <ComboBoxItem Content="Float"/>
                                                <ComboBoxItem Content="String"/>
                                            </ComboBox>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Categórico?" HorizontalAlignment="Center" Style="{StaticResource MaterialDesignBody2TextBlock}"/>
                                                <ToggleButton HorizontalAlignment="Center" Style="{StaticResource MaterialDesignSwitchToggleButton}"/>
                                            </StackPanel>
                                        </UniformGrid>
                                    </materialDesign:Card>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!--Fim Configuração Futura-->

                        <!--Começo Cartão Configuração de Schema-->

                        <materialDesign:Card UniformCornerRadius="10"
                                             Margin="0,0,0,20">

                            <GroupBox  Margin="0" Height="500" Header="MAPEAMENTO DE COLUNAS (SCHEMA)">
                                <GroupBox.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" 
                                                   HorizontalAlignment="Center" 
                                                   Width="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}, Path=ActualWidth}"
                                                   TextAlignment="Center"
                                                   FontWeight="Bold"/>
                                    </DataTemplate>
                                </GroupBox.HeaderTemplate>

                                <DockPanel>
                                    <Button DockPanel.Dock="Top"
                                            Style="{StaticResource MaterialDesignRaisedButton}"
                                            Content="Carregar Schema" 
                                            Margin="30,0,30,10" 
                                            MaxWidth="300"
                                            Height="40" 
                                            FontSize="20"
                                            HorizontalAlignment="Right"
                                            Cursor="Hand"/>

                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="10" Cursor="">
                                        <StackPanel Margin="5">
                                            <Grid>
                                                <materialDesign:Card x:Name="PosicaoSchema"
                                                                     Margin="7" Padding="12"                                                    
                                                                     materialDesign:ElevationAssist.Elevation="Dp2"
                                                                     UniformCornerRadius="10">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <ComboBox materialDesign:HintAssist.Hint="Tipo"
                                                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                                                  materialDesign:TextFieldAssist.TextFieldCornerRadius="10"
                                                                  Margin="10, 10, 20, 10"
                                                                  Width="70"
                                                                  Height="50"
                                                                  Grid.Column="0">
                                                            <ComboBoxItem Content="1"
                                                                          Width="Auto"/>
                                                        </ComboBox>

                                                        <Rectangle Width="1"
                                                                   Grid.Column="1"
                                                                   Fill="#D1D1D1"
                                                                   Height="Auto"
                                                                   Margin="10"/>


                                                        <WrapPanel Grid.Column="2"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center">
                                                            <StackPanel Margin="5, 10" Width="250">
                                                                <TextBox materialDesign:HintAssist.Hint="Coluna" 
                                                                         Text="Ex: Idade" 
                                                                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                                                         Width="250"
                                                                         FontSize="18"/>
                                                            </StackPanel>

                                                            <StackPanel Margin="10,5" MinWidth="50">
                                                                <TextBlock Text="Categórico?"
                                                                           VerticalAlignment="Center" Margin="20,0,20,5"
                                                                           Style="{StaticResource MaterialDesignBody2TextBlock}"/>
                                                                
                                                                <ToggleButton Style="{StaticResource MaterialDesignSwitchToggleButton}" 
                                                                              VerticalAlignment="Center"
                                                                              Margin="20,0"
                                                                              ToolTip="Marque se a coluna for uma categoria"/>
                                                            </StackPanel>

                                                            <StackPanel Margin="5,10" MinWidth="185">
                                                                <ComboBox materialDesign:HintAssist.Hint="Finalidade"
                                                                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                                                          materialDesign:TextFieldAssist.TextFieldCornerRadius="10"
                                                                          Width="200"
                                                                          Height="50">
                                                                    <ComboBoxItem Content="Feature"/>
                                                                    <ComboBoxItem Content="Label (Target)"/>
                                                                    <ComboBoxItem Content="Ignore"/>
                                                                </ComboBox>
                                                            </StackPanel>

                                                            <StackPanel Margin="10" MinWidth="185">
                                                                <ComboBox materialDesign:HintAssist.Hint="Tipo"
                                                                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                                                          materialDesign:TextFieldAssist.TextFieldCornerRadius="10"
                                                                          Width="200"
                                                                          Height="50">
                                                                    <ComboBoxItem Content="Single"/>
                                                                    <ComboBoxItem Content="Boolean"/>
                                                                    <ComboBoxItem Content="DateTime"/>
                                                                </ComboBox>
                                                            </StackPanel>
                                                        </WrapPanel>

                                                        <Button  Style="{StaticResource MaterialDesignOutlinedButton}"
                                                                  Grid.Column="3"
                                                                  HorizontalAlignment="Right"
                                                                  Height="40"
                                                                  Width="55"
                                                                  Margin="0,10"
                                                                  Cursor="Hand">

                                                            <materialDesign:PackIcon Kind="Trash" 
                                                                                     VerticalAlignment="Center"
                                                                                     Width="Auto" 
                                                                                     Height="Auto"/>
                                                        </Button>
                                                    </Grid>
                                                </materialDesign:Card>
                                            </Grid>
                                        </StackPanel>
                                    </ScrollViewer>
                                </DockPanel>
                            </GroupBox>
                        </materialDesign:Card>


                        <!--Fim Cartão Configuração de Schema-->

                    </Grid>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!--Fim MAPEAMENTO DE COLUNAS (SCHEMA)-->
        
    </DockPanel>
</Page>
