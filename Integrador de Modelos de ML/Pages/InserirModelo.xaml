<Page x:Class="Integrador_de_Modelos_de_ML.Pages.InserirModelo"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Title="Inserir Modelo"
      Background="{DynamicResource MaterialDesignPaper}">

    <Grid Background="#F0F2F5">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="450">

            <TextBlock Text="Novo Modelo de ML" FontSize="28" FontWeight="ExtraBold" 
                   Foreground="#1A202C" HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <Border Background="White" CornerRadius="15" Padding="30">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" Opacity="0.05" Direction="270"/>
                </Border.Effect>

                <StackPanel>
                    <TextBlock Text="NOME DO MODELO" FontSize="11" FontWeight="Bold" Foreground="#718096" Margin="0,0,0,8"/>
                    <TextBox x:Name="TxtNomeModelo" Height="40" Padding="10,5" VerticalContentAlignment="Center"
                         BorderThickness="1" BorderBrush="#E2E8F0" Margin="0,0,0,20">
                        <TextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>

                    <TextBlock Text="VARIÁVEL ALVO (COLUNA DE PREVISÃO)" FontSize="11" FontWeight="Bold" Foreground="#718096" Margin="0,0,0,8"/>
                    <ComboBox x:Name="CbTarget" Height="40" VerticalContentAlignment="Center" Margin="0,0,0,20"/>

                    <TextBlock Text="CAMINHO DO DATASET (.CSV)" FontSize="11" FontWeight="Bold" Foreground="#718096" Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,30">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtPath" Height="40" Padding="10,5" VerticalContentAlignment="Center" IsReadOnly="True" />
                        <Button Grid.Column="1" Content="BUSCAR" Width="80" Margin="10,0,0,0" Background="#EDF2F7" BorderThickness="0"/>
                    </Grid>

                    <Button x:Name="BotaoCriarModelo" Content="CRIAR MODELO AGORA" Background="#0066cc" Foreground="White" 
                        FontWeight="Bold" Height="50" Cursor="Hand" Click="BtnCriarModelo_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Page>